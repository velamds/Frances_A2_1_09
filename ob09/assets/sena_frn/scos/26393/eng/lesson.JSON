dback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}]}, "type": "feedback"}, {"type": "learning_skills", "contents": [{"content": "Reading", "type": "skill"}, {"content": "Writing", "type": "skill"}, {"content": "Speaking", "type": "skill"}]}, {"type": "post_instructions", "contents": [{"content": "Consignes : Compl\u00e9tez les \u00e9tapes suivantes. Remplissez la grille d'auto-\u00e9valuation.", "type": "text"}]}], "type": "DWS", "template_override": 1}], "stimuli": [{"_data": [], "type": "welcome", "contents": [{}], "template_override": 1, "id": 0}, {"id": 1, "title": "", "contents": [{"value": {"images": [{"text": "", "id": 0, "time": "0", "image": "frn4le09ob09re2img05.jpg"}, {"text": "<span class=\"strong\">Pierre</span> : Bonjour Charlotte ! <br/>\n<span class=\"strong\">Charlotte</span> : Pierre ! D\u00e9j\u00e0 ! Quelle surprise ! Je m'amuse beaucoup \u00e0 Amsterdam.<br>\n<span class=\"strong\">Pierre</span> : Pourrais-tu me parler de tes exp\u00e9riences ? <br>\n<span class=\"strong\">Charlotte</span> : Avec plaisir. Je suis all\u00e9e au mus\u00e9e de Van Gogh, j'ai pass\u00e9 une journ\u00e9e dans un centre de remise en forme et j'ai fait un tour des canaux en bateau.", "id": 1, "time": "100", "image": "frn4le09ob09re2img05.jpg"}, {"text": "<span class=\"strong\">Pierre</span> :  Impressionnant ! Puis-je te demander une faveur ?<br>\n<span class=\"strong\">Charlotte</span> :  Bien s\u00fbr. N'importe quoi. <br>\n<span class=\"strong\">Pierre</span> : J'ai besoin de tes conseils. Je veux inviter une fille \u00e0 sortir avec moi.  <br>\n<span class=\"strong\">Charlotte</span> : Super ! Elle doit \u00eatre une personne sp\u00e9ciale pour toi. Je sais que tu ne sors pas avec n'importe qui.", "id": 2, "time": "20000", "image": "frn4le09ob09re2img05.jpg"}, {"text": "<span class=\"strong\">Pierre</span> : Je suis un peu nerveux. Je veux faire bonne impression. O\u00f9 devrions-nous aller ? <br>\n<span class=\"strong\">Charlotte</span> :  Vous pourriez aller voir un film. <br>\n<span class=\"strong\">Pierre</span> : Oui, on pourrait faire \u00e7a.", "id": 3, "time": "37000", "image": "frn4le09ob09re2img05.jpg"}, {"text": "<span class=\"strong\">Charlotte</span> : Ou bien, vous pouvez aller d\u00eener quelque part.  <br>\n<span class=\"strong\">Pierre</span> : Oui, c'est une possibilit\u00e9, mais pas n'importe o\u00f9.", "id": 4, "time": "47000", "image": "frn4le09ob09re2img05.jpg"}, {"text": "<span class=\"strong\">Charlotte</span> : Allez \u00e0 notre lieu de pr\u00e9dilection, au resto italien ! <br>\n<span class=\"strong\">Pierre</span> : Tu as raison. C'est une bonne id\u00e9e. Merci pour ces suggestions.  <br>\n<span class=\"strong\">Charlotte</span> : Quand tu veux ! Si tu as encore besoin de moi, tu peux m'appeler n'importe quand !", "id": 5, "time": "54000", "image": "frn4le09ob09re2img01.jpg"}], "audiosrc": "frn4le09ob09re2aud01", "coverimg": "frn4le09ob09re2img05.jpg"}, "type": "slideshow"}], "_data": [], "type": "audio", "template_override": 1}]}]}