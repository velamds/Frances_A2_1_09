plate_override": 1}], "stimuli": [{"_data": [], "type": "welcome", "contents": [{}], "template_override": 1, "id": 0}, {"id": 1, "title": "", "contents": [{"value": {"images": [{"text": "", "id": 0, "time": "0", "image": "frn4le09ob06re2img05.jpg"}, {"text": "<span class=\"strong prelo-dialogue-100\">R\u00e9ceptionniste</span> : Sant\u00e9 Soleil, comment puis-je vous aider ?<br>\n<span class=\"strong\">Charlotte</span> : Bonjour. J'aimerais faire une r\u00e9servation dans votre centre de remise en forme s'il vous pla\u00eet.", "id": 1, "time": "100", "image": "frn4le09ob06re2img05.jpg"}, {"text": "<span class=\"strong prelo-dialogue-100\">R\u00e9ceptionniste</span> : Nous avons des places disponibles pour demain. Est-ce que ce sera pour toute la journ\u00e9e&nbsp;? <br>\n<span class=\"strong\">Charlotte</span> : Oui. Quels services offrez-vous ? <br>\n<span class=\"strong\">R\u00e9ceptionniste</span> : Nous avons deux forfaits. Si votre but est de vous d\u00e9tendre, vous pouvez choisir l'option \"Journ\u00e9e repos\". Si vous d\u00e9sirez plut\u00f4t un traitement esth\u00e9tique, vous pourriez opter pour le service \"Soin de la peau\".  Il serait aussi possible de prendre un forfait combin\u00e9.", "id": 2, "time": "9000", "image": "frn4le09ob06re2img01.jpg"}, {"text": "<span class=\"strong prelo-dialogue-100\">Charlotte</span> : Offrez-vous le service de manucure ? <br>\n<span class=\"strong\">R\u00e9ceptionniste</span> : Bien entendu. <br>\n<span class=\"strong\">Charlotte</span> : Mes pieds me font mal. Pourriez-vous me sugg\u00e9rer quelque chose ?<br>\n<span class=\"strong\">R\u00e9ceptionniste</span> : Le forfait \"Soin de la peau\" comprend aussi une p\u00e9dicure. <br>\n<span class=\"strong\">Charlotte</span> : C'est parfait. J'irai demain. <br>", "id": 3, "time": "31000", "image": "frn4le09ob06re2img02.jpg"}, {"text": "<span class=\"strong prelo-dialogue-100\">R\u00e9ceptionniste</span> : Voulez-vous faire une r\u00e9servation pour le forfait combin\u00e9 ? <br>\n<span class=\"strong\">Charlotte</span> : Oui, s'il vous pla\u00eet. <br>\n<span class=\"strong\">R\u00e9ceptionniste</span> : Tr\u00e8s bien. Avec le forfait combin\u00e9, vous aurez le d\u00e9jeuner inclus. <br>\n<span class=\"strong\">Charlotte</span> : Parfait. J'ai h\u00e2te !", "id": 4, "time": "47500", "image": "frn4le09ob06re2img05.jpg"}], "audiosrc": "frn4le09ob06re2aud01", "coverimg": "frn4le09ob06re2img05.jpg"}, "type": "slideshow"}], "_data": [], "type": "audio", "template_override": 1}]}]}